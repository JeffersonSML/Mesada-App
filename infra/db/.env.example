# Copie para .env (nunca comite o .env real) e ajuste os valores.

PGHOST=localhost
PGPORT=5432
PGDATABASE=mesada

# Credenciais de superusuário, usadas só pelo script de provisionamento
# (criação do banco, das roles e execução das migrações).
PGSUPERUSER=postgres
PGSUPERUSER_PASSWORD=postgres

# Senhas das roles de aplicação (ver 002_roles.sql). Gere valores fortes em
# produção — estes são só para desenvolvimento local.
MESADA_APP_DB_PASSWORD=changeme
MESADA_ADMIN_DB_PASSWORD=changeme
