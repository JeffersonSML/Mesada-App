# Copie para .env (nunca comite o .env real) e ajuste os valores.
# Usado por infra/deploy/docker-compose.yml.

PGDATABASE=mesada
PGSUPERUSER=postgres
PGSUPERUSER_PASSWORD=troque-por-uma-senha-forte

MESADA_APP_DB_PASSWORD=troque-por-uma-senha-forte
MESADA_ADMIN_DB_PASSWORD=troque-por-uma-senha-forte

# 32+ bytes aleatórios — ex.: `openssl rand -base64 48`
JWT_CHAVE=

# Stone/Pagar.me (sk_test_... em sandbox, sk_... em produção). Vazio = pagamentos desativados.
PAGARME_SECRET_KEY=

# Resend (https://resend.com/api-keys). Vazio = e-mails desativados.
RESEND_API_KEY=
EMAIL_REMETENTE=nao-responda@mesadaapp.com.br

# MinIO (S3-compatível) — credenciais que você escolhe, não vêm de lugar nenhum externo.
S3_ACCESS_KEY=troque-por-uma-chave
S3_SECRET_KEY=troque-por-uma-senha-forte
S3_BUCKET_NAME=mesada-evidencias

# Antes de subir a stack: coloque o JSON da service account do Firebase em
# infra/deploy/fcm-service-account.json (nunca versionado — já no .gitignore).
