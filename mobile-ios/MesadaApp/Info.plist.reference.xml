    <string>Precisamos da câmera para você registrar a foto de evidência ao concluir uma tarefa.</string>
    <key>NSFaceIDUsageDescription</key>
    <string>Use o Face ID para desbloquear o app rapidamente, com mais segurança que um PIN.</string>
</dict>
</plist>
